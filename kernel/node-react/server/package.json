{
  "name": "kernel-server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "24.13.1"
  },
  "scripts": {
    "start": "node src/main.ts",
    "migrate": "node tools/migrate.ts",
    "dev": "node --watch src/main.ts",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "verify": "tsc --noEmit && vitest run && eslint ."
  },
  "dependencies": {
    "fastify": "5.8.5"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "eslint": "10.2.1",
    "typescript": "5.8.3",
    "typescript-eslint": "8.59.0",
    "vitest": "4.1.5"
  }
}
